import csv
import math
from google.colab import files
from Bio.PDB import PDBParser

def upload_pdb_file():
    print("Please upload your local PDB file:")
    uploaded = files.upload()
    if not uploaded:
        raise FileNotFoundError("No file uploaded. Please upload a valid PDB file.")
    filename = list(uploaded.keys())[0]
    return filename

def get_salt_bridge_atoms(structure):
    """
    Extracts basic (positively charged) and acidic (negatively charged)
    side-chain functional group atoms.

    Basic residues:
      - ARG: CZ (or NH1, NH2)
      - LYS: NZ
      - HIS: ND1, NE2 (protonated state dependent)

    Acidic residues:
      - ASP: CG (or OD1, OD2)
      - GLU: CD (or OE1, OE2)
    """
    basic_residues = {'ARG': ['NH1', 'NH2'], 'LYS': ['NZ'], 'HIS': ['ND1', 'NE2']}
    acidic_residues = {'ASP': ['OD1', 'OD2'], 'GLU': ['OE1', 'OE2']}

    pos_atoms = [] # (chain_id, res_name, res_id, atom_name, atom_obj)
    neg_atoms = [] # (chain_id, res_name, res_id, atom_name, atom_obj)

    for model in structure:
        for chain in model:
            for residue in chain:
                res_name = residue.get_resname().strip()
                res_id = residue.get_id()[1]
                chain_id = chain.get_id()

                # Collect positively charged side-chain atoms
                if res_name in basic_residues:
                    for atom_name in basic_residues[res_name]:
                        if atom_name in residue:
                            pos_atoms.append((chain_id, res_name, res_id, atom_name, residue[atom_name]))

                # Collect negatively charged side-chain atoms
                elif res_name in acidic_residues:
                    for atom_name in acidic_residues[res_name]:
                        if atom_name in residue:
                            neg_atoms.append((chain_id, res_name, res_id, atom_name, residue[atom_name]))

    return pos_atoms, neg_atoms

def find_salt_bridges(pos_atoms, neg_atoms, distance_cutoff=5.0):
    """Calculates Euclidean distances between basic and acidic atom pairs within the cutoff."""
    salt_bridges = []

    for pos in pos_atoms:
        c1, rname1, rid1, aname1, atom1 = pos
        for neg in neg_atoms:
            c2, rname2, rid2, aname2, atom2 = neg

            # Skip if comparing same residue (intra-residue interaction)
            if c1 == c2 and rid1 == rid2:
                continue

            # Calculate distance between atoms
            distance = atom1 - atom2  # Biopython subtract operator computes Euclidean distance

            if distance <= distance_cutoff:
                salt_bridges.append({
                    'Chain_1': c1,
                    'Residue_1': rname1,
                    'ResNum_1': rid1,
                    'Atom_1': aname1,
                    'Chain_2': c2,
                    'Residue_2': rname2,
                    'ResNum_2': rid2,
                    'Atom_2': aname2,
                    'Distance_Angstrom': round(distance, 3)
                })

    return salt_bridges

def save_to_csv(salt_bridges, output_filename="salt_bridges.csv"):
    """Writes detected salt bridge contacts into a CSV file."""
    headers = [
        'Chain_1', 'Residue_1', 'ResNum_1', 'Atom_1',
        'Chain_2', 'Residue_2', 'ResNum_2', 'Atom_2',
        'Distance_Angstrom'
    ]

    with open(output_filename, mode='w', newline='') as file:
        writer = csv.DictWriter(file, fieldnames=headers)
        writer.writeheader()
        writer.writerows(salt_bridges)

    print(f"\nSuccessfully identified {len(salt_bridges)} contact pairs within 5.0 Å.")
    print(f"Results saved to: {output_filename}")

# --- Main Execution ---
if __name__ == "__main__":
    # 1. Upload local PDB
    pdb_path = upload_pdb_file()

    # 2. Parse PDB structure
    parser = PDBParser(QUIET=True)
    structure = parser.get_structure("protein", pdb_path)

    # 3. Extract charged atoms & find salt bridges <= 5.0 Å
    pos_atoms, neg_atoms = get_salt_bridge_atoms(structure)
    bridges = find_salt_bridges(pos_atoms, neg_atoms, distance_cutoff=5.0)

    # 4. Save results to CSV & offer direct download
    csv_filename = "salt_bridges.csv"
    save_to_csv(bridges, csv_filename)
    files.download(csv_filename)